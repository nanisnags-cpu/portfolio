    replacement_chunks {
      replacement_content: "export const toolLogos = [\n  { name: \"Photoshop\", icon: \"Ps\", gradient: \"from-blue-700 to-blue-400\" },\n  { name: \"Illustrator\", icon: \"Ai\", gradient: \"from-orange-600 to-orange-400\" },\n  { name: \"Figma\", icon: \"F\", gradient: \"from-pink-500 via-purple-500 to-blue-500\" },\n  { name: \"Adobe XD\", icon: \"Xd\", gradient: \"from-pink-700 to-pink-400\" },\n  { name: \"Premiere Pro\", icon: \"Pr\", gradient: \"from-purple-800 to-purple-500\" },\n  { name: \"After Effects\", icon: \"Ae\", gradient: \"from-indigo-800 to-indigo-500\" },\n  { name: \"Lightroom\", icon: \"Lr\", gradient: \"from-sky-700 to-sky-400\" },\n  { name: \"CorelDRAW\", icon: \"Cd\", gradient: \"from-green-600 to-green-400\" },\n  { name: \"WordPress\", icon: \"W\", gradient: \"from-slate-700 to-slate-500\" },\n  { name: \"Elementor\", icon: \"E\", gradient: \"from-rose-600 to-rose-400\" },\n  { name: \"Divi\", icon: \"D\", gradient: \"from-pink-500 to-purple-500\" },\n  { name: \"Shopify\", icon: \"S\", gradient: \"from-emerald-600 to-emerald-400\" },\n  { name: \"WooCommerce\", icon: \"Woo\", gradient: \"from-purple-600 to-purple-400\" },\n  { name: \"HTML5\", icon: \"</>\", gradient: \"from-orange-600 to-orange-400\" },\n  { name: \"CSS3\", icon: \"{ }\", gradient: \"from-blue-600 to-blue-400\" },\n  { name: \"JavaScript\", icon: \"JS\", gradient: \"from-yellow-400 to-yellow-300\", textDark: true },\n];\n\nexport function TechStack() {\n  // Split into two arrays for distinct scrolling rows\n  const mid = Math.ceil(toolLogos.length / 2);\n  const row1 = toolLogos.slice(0, mid);\n  const row2 = toolLogos.slice(mid);\n\n  // Duplicate arrays to create a seamless infinite scroll width\n  const infiniteRow1 = [...row1, ...row1, ...row1, ...row1];\n  const infiniteRow2 = [...row2, ...row2, ...row2, ...row2];\n\n  const renderCard = (tool: any, idx: number) => (\n    <div key={`${tool.name}-${idx}`} className=\"flex items-center gap-4 min-w-[220px] px-5 py-3 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/50 dark:border-zinc-800 shadow-sm hover:-translate-y-2 hover:shadow-xl dark:hover:shadow-zinc-900/50 transition-all duration-300 cursor-pointer group hover:border-zinc-300 dark:hover:border-zinc-700\">\n      <div className={`flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-br ${tool.gradient} ${tool.textDark ? \'text-zinc-900\' : \'text-white\'} font-bold text-xl shadow-lg group-hover:scale-110 transition-transform duration-300`}>\n        {tool.icon}\n      </div>\n      <span className=\"font-medium text-zinc-700 dark:text-zinc-300 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors\">\n        {tool.name}\n      </span>\n    </div>\n  );\n\n  return (\n    <section className=\"py-24 bg-zinc-50 dark:bg-zinc-950 transition-colors border-y border-zinc-200/50 dark:border-white/5 overflow-hidden\">\n      <div className=\"mx-auto max-w-6xl px-6 mb-16 text-center\">\n        <span className=\"mb-4 block text-sm font-semibold uppercase tracking-widest text-emerald-600 dark:text-emerald-400\">\n          Tech & Tools\n        </span>\n        <h2 className=\"text-3xl font-medium tracking-tight text-zinc-900 dark:text-zinc-50 md:text-5xl\">\n          Software & Technologies\n        </h2>\n      </div>\n\n      <div className=\"marquee-container relative flex flex-col gap-6 w-full overflow-hidden py-4\">\n        {/* Gradients to fade out the edges smoothly */}\n        <div className=\"absolute left-0 top-0 bottom-0 w-24 md:w-48 bg-gradient-to-r from-zinc-50 dark:from-zinc-950 to-transparent z-10 pointer-events-none transition-colors\" />\n        <div className=\"absolute right-0 top-0 bottom-0 w-24 md:w-48 bg-gradient-to-l from-zinc-50 dark:from-zinc-950 to-transparent z-10 pointer-events-none transition-colors\" />\n        \n        {/* Row 1 - Scrolling Left */}\n        <div className=\"flex w-max animate-marquee gap-6\">\n          {infiniteRow1.map((tool, idx) => renderCard(tool, idx))}\n        </div>\n        \n        {/* Row 2 - Scrolling Right */}\n        <div className=\"flex w-max animate-marquee-reverse gap-6\">\n          {infiniteRow2.map((tool, idx) => renderCard(tool, idx))}\n        </div>\n      </div>\n    </section>\n  );\n}"
    }
