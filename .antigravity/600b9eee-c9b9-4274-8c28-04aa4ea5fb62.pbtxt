    replacement_chunks {
      target_content: "import { siteData } from \"../data\";\nimport { AnimatedSection, SectionHeading } from \"./AnimatedSection\";\nimport { Award, CheckCircle2, GraduationCap } from \"lucide-react\";\n\nexport function Skills() {\n  return (\n    <AnimatedSection id=\"skills\" className=\"bg-zinc-50/50 block\">\n      <SectionHeading subtitle=\"Expertise\" title=\"Skills That Drive Results\" />\n      \n      <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-24\">\n        {Object.entries(siteData.skills).map(([category, skills]) => (\n          <div key={category} className=\"bg-white rounded-[2rem] p-8 border border-zinc-200/50 shadow-sm\">\n            <h3 className=\"text-sm font-semibold uppercase tracking-widest text-zinc-400 mb-6 border-b border-zinc-100 pb-4\">\n              {category}\n            </h3>\n            <ul className=\"space-y-4\">\n              {skills.map((skill) => (\n                <li key={skill} className=\"flex items-center gap-3 text-zinc-700 font-medium text-sm\">\n                  <CheckCircle2 size={16} className=\"text-emerald-500\" />\n                  {skill}\n                </li>\n              ))}\n            </ul>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"grid lg:grid-cols-2 gap-16\">\n        <div>\n          <div className=\"flex items-center gap-3 mb-8\">\n            <Award className=\"text-emerald-600\" size={28} />\n            <h3 className=\"text-2xl font-medium tracking-tight text-zinc-900\">Achievements</h3>\n          </div>\n          <div className=\"space-y-6\">\n            {siteData.achievements.map((acc, i) => (\n              <div key={i} className=\"bg-white rounded-3xl p-8 border border-emerald-100 shadow-sm relative overflow-hidden group\">\n                <div className=\"absolute top-0 right-0 w-32 h-32 bg-emerald-500/5 rounded-full -translate-y-1/2 translate-x-1/2 transition-transform group-hover:scale-150\" />\n                <h4 className=\"text-lg font-medium text-zinc-900 mb-2 relative z-10\">{acc.title}</h4>\n                <p className=\"text-zinc-500 text-sm leading-relaxed relative z-10\">{acc.description}</p>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        <div>\n          <div className=\"flex items-center gap-3 mb-8\">\n            <GraduationCap className=\"text-emerald-600\" size={28} />\n            <h3 className=\"text-2xl font-medium tracking-tight text-zinc-900\">Certifications</h3>\n          </div>\n          <div className=\"bg-zinc-900 text-white rounded-[2rem] p-8 md:p-10\">\n            <ul className=\"space-y-6\">\n              {siteData.certifications.map((cert, i) => (\n                <li key={i} className=\"flex items-start gap-4\">\n                  <div className=\"mt-1 flex-shrink-0 w-1.5 h-1.5 rounded-full bg-emerald-500\" />\n                  <span className=\"text-sm md:text-base font-medium text-zinc-300 leading-relaxed\">{cert}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n        </div>\n      </div>\n    </AnimatedSection>\n  );\n}"
      replacement_content: "import { siteData } from \"../data\";\nimport { AnimatedSection, SectionHeading } from \"./AnimatedSection\";\nimport { Award, CheckCircle2, GraduationCap } from \"lucide-react\";\n\nexport function Skills() {\n  return (\n    <AnimatedSection id=\"skills\" className=\"bg-zinc-50/50 dark:bg-zinc-950/50 block transition-colors\">\n      <SectionHeading subtitle=\"Expertise\" title=\"Skills That Drive Results\" />\n      \n      <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-24\">\n        {Object.entries(siteData.skills).map(([category, skills]) => (\n          <div key={category} className=\"bg-white dark:bg-zinc-900 rounded-[2rem] p-8 border border-zinc-200/50 dark:border-white/10 shadow-sm transition-colors\">\n            <h3 className=\"text-sm font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-6 border-b border-zinc-100 dark:border-white/10 pb-4\">\n              {category}\n            </h3>\n            <ul className=\"space-y-4\">\n              {skills.map((skill) => (\n                <li key={skill} className=\"flex items-center gap-3 text-zinc-700 dark:text-zinc-300 font-medium text-sm\">\n                  <CheckCircle2 size={16} className=\"text-emerald-500 dark:text-emerald-400\" />\n                  {skill}\n                </li>\n              ))}\n            </ul>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"grid lg:grid-cols-2 gap-16\">\n        <div>\n          <div className=\"flex items-center gap-3 mb-8\">\n            <Award className=\"text-emerald-600 dark:text-emerald-400\" size={28} />\n            <h3 className=\"text-2xl font-medium tracking-tight text-zinc-900 dark:text-zinc-50\">Achievements</h3>\n          </div>\n          <div className=\"space-y-6\">\n            {siteData.achievements.map((acc, i) => (\n              <div key={i} className=\"bg-white dark:bg-zinc-900 rounded-3xl p-8 border border-emerald-100 dark:border-emerald-500/20 shadow-sm relative overflow-hidden group transition-colors\">\n                <div className=\"absolute top-0 right-0 w-32 h-32 bg-emerald-500/5 rounded-full -translate-y-1/2 translate-x-1/2 transition-transform group-hover:scale-150\" />\n                <h4 className=\"text-lg font-medium text-zinc-900 dark:text-zinc-50 mb-2 relative z-10\">{acc.title}</h4>\n                <p className=\"text-zinc-500 dark:text-zinc-400 text-sm leading-relaxed relative z-10\">{acc.description}</p>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        <div>\n          <div className=\"flex items-center gap-3 mb-8\">\n            <GraduationCap className=\"text-emerald-600 dark:text-emerald-400\" size={28} />\n            <h3 className=\"text-2xl font-medium tracking-tight text-zinc-900 dark:text-zinc-50\">Certifications</h3>\n          </div>\n          <div className=\"bg-zinc-900 dark:bg-black text-white rounded-[2rem] p-8 md:p-10 border border-transparent dark:border-white/10 transition-colors\">\n            <ul className=\"space-y-6\">\n              {siteData.certifications.map((cert, i) => (\n                <li key={i} className=\"flex items-start gap-4\">\n                  <div className=\"mt-1 flex-shrink-0 w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400\" />\n                  <span className=\"text-sm md:text-base font-medium text-zinc-300 leading-relaxed\">{cert}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n        </div>\n      </div>\n    </AnimatedSection>\n  );\n}"
    }
