    replacement_chunks {
      target_content: "      <div className=\"grid md:grid-cols-2 gap-8\">\n        <AnimatePresence mode=\"popLayout\">\n          {filteredProjects.map((project, i) => (\n            <motion.div\n              layout\n              initial={{ opacity: 0, scale: 0.95 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 0.95 }}\n              transition={{ duration: 0.4 }}\n              key={project.title}\n              className=\"group relative cursor-pointer overflow-hidden rounded-[2rem] bg-zinc-50 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 p-8 sm:p-10 hover:border-zinc-200 dark:hover:border-zinc-700 transition-colors\"\n            >\n              {/* Dummy decorative image background depending on index for visual variety */}\n              <div className=\"absolute inset-0 bg-gradient-to-br from-white/50 dark:from-zinc-800/30 to-transparent mix-blend-overlay pointer-events-none\" />\n              \n              <div className=\"relative z-10 flex h-full flex-col justify-between\">\n                <div>\n                  <div className=\"flex flex-wrap gap-2 mb-6\">\n                    {project.tags.map(tag => (\n                      <span key={tag} className=\"rounded-full bg-white dark:bg-zinc-800 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-300 shadow-sm border border-transparent dark:border-white/5\">\n                        {tag}\n                      </span>\n                    ))}\n                  </div>\n                  <h3 className=\"text-2xl sm:text-3xl font-medium tracking-tight text-zinc-900 dark:text-zinc-50 mb-2\">{project.title}</h3>\n                  <div className=\"text-emerald-600 dark:text-emerald-400 font-medium text-sm uppercase tracking-wider mb-6 block\">{project.role}</div>\n                  <p className=\"text-zinc-500 dark:text-zinc-400 leading-relaxed mb-10 max-w-md\">{project.description}</p>\n                </div>\n                \n                <div className=\"flex items-center gap-4 mt-auto\">\n                  <div className=\"flex h-12 w-12 items-center justify-center rounded-full bg-white dark:bg-zinc-950 shadow-sm transition-transform group-hover:scale-110 group-hover:shadow-md text-zinc-900 dark:text-zinc-50\">\n                    <ExternalLink size={20} />\n                  </div>\n                  <span className=\"text-sm font-medium text-zinc-900 dark:text-zinc-50 opacity-0 transform translate-x-2 transition-all group-hover:opacity-100 group-hover:translate-x-0\">View Details</span>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </AnimatePresence>\n      </div>"
      replacement_content: "      <div className=\"grid md:grid-cols-2 gap-10\">\n        <AnimatePresence mode=\"popLayout\">\n          {filteredProjects.map((project, i) => (\n            <motion.div\n              layout\n              initial={{ opacity: 0, scale: 0.95 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 0.95 }}\n              transition={{ duration: 0.4 }}\n              key={project.title}\n              className=\"group relative cursor-pointer overflow-hidden rounded-[2.5rem] bg-zinc-50 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-850 p-6 flex flex-col justify-between hover:border-zinc-200 dark:hover:border-zinc-700 hover:shadow-xl dark:hover:shadow-emerald-950/10 transition-all duration-300\"\n            >\n              <div>\n                {/* Simulated Safari Browser Window Mockup Frame */}\n                {project.image && (\n                  <div className=\"w-full rounded-2xl overflow-hidden border border-zinc-200/60 dark:border-zinc-800 bg-white dark:bg-zinc-950 shadow-sm mb-6 flex flex-col transition-all group-hover:shadow-md\">\n                    {/* Browser Header Bar */}\n                    <div className=\"h-9 px-4 bg-zinc-100/50 dark:bg-zinc-900 border-b border-zinc-200/50 dark:border-zinc-800 flex items-center justify-between\">\n                      {/* Window Action Buttons */}\n                      <div className=\"flex gap-1.5\">\n                        <span className=\"w-2.5 h-2.5 rounded-full bg-rose-500/80 block\"></span>\n                        <span className=\"w-2.5 h-2.5 rounded-full bg-amber-500/80 block\"></span>\n                        <span className=\"w-2.5 h-2.5 rounded-full bg-emerald-500/80 block\"></span>\n                      </div>\n                      {/* URL Display Bar */}\n                      <div className=\"w-1/2 h-5 rounded bg-white dark:bg-zinc-950 border border-zinc-200/30 dark:border-zinc-800/60 flex items-center justify-center text-[10px] text-zinc-400 dark:text-zinc-500 font-mono truncate px-4\">\n                        {project.link !== \"#\" ? project.link.replace(\"https://\", \"\") : `${project.title.toLowerCase().replace(/\\s+/g, \"\")}.com`}\n                      </div>\n                      <div className=\"w-8\"></div>\n                    </div>\n                    {/* Browser Inner Page Window Frame */}\n                    <div className=\"relative aspect-[16/10] overflow-hidden bg-zinc-100 dark:bg-zinc-900\">\n                      <img \n                        src={project.image} \n                        alt={`${project.title} Preview`}\n                        loading=\"lazy\"\n                        referrerPolicy=\"no-referrer\"\n                        className=\"w-full h-full object-cover grayscale opacity-90 group-hover:grayscale-0 group-hover:scale-102 group-hover:opacity-100 transition-all duration-500 ease-out\"\n                      />\n                      {/* Interactive hover overlay */}\n                      <div className=\"absolute inset-0 bg-black/10 dark:bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center\">\n                        <span className=\"rounded-full bg-white/90 dark:bg-zinc-900/90 backdrop-blur-md px-4 py-2 text-xs font-semibold tracking-wider text-zinc-900 dark:text-zinc-50 shadow-lg flex items-center gap-2 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300\">\n                          {project.link !== \"#\" ? \"Explore Live Site\" : \"Preview Details\"} <ExternalLink size={12} />\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n                )}\n\n                <div className=\"flex flex-wrap gap-2 mb-4\">\n                  {project.tags.map(tag => (\n                    <span key={tag} className=\"rounded-full bg-white dark:bg-zinc-800 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-300 shadow-sm border border-zinc-120 dark:border-white/5\">\n                      {tag}\n                    </span>\n                  ))}\n                  {project.platform && (\n                    <span className=\"rounded-full bg-emerald-50 dark:bg-emerald-500/15 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 shadow-sm border border-emerald-100/30 dark:border-emerald-500/10\">\n                      {project.platform}\n                    </span>\n                  )}\n                </div>\n\n                <h3 className=\"text-2xl sm:text-3xl font-medium tracking-tight text-zinc-900 dark:text-zinc-50 mb-1\">{project.title}</h3>\n                <div className=\"text-emerald-600 dark:text-emerald-405 font-medium text-xs uppercase tracking-wider mb-4 block\">{project.role}</div>\n                <p className=\"text-zinc-500 dark:text-zinc-400 text-sm leading-relaxed mb-8 max-w-lg\">{project.description}</p>\n              </div>\n\n              <div className=\"flex items-center justify-between mt-auto pt-4 border-t border-zinc-100 dark:border-zinc-800/40\">\n                {project.link && project.link !== \"#\" ? (\n                  <a \n                    href={project.link}\n                    target=\"_blank\"\n                    rel=\"noreferrer\"\n                    className=\"flex items-center gap-3 text-sm font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors\"\n                  >\n                    <div className=\"flex h-10 w-10 items-center justify-center rounded-full bg-emerald-50 dark:bg-emerald-500/10 shadow-sm text-emerald-600 dark:text-emerald-400 hover:scale-105 transition-transform\">\n                      <ExternalLink size={16} />\n                    </div>\n                    <span>Visit Live Website</span>\n                  </a>\n                ) : (\n          