      original_chunk {
        target_content: "export const siteData = {\n  hero: {\n    headline: \"Senior Visual & Web Designer Creating Powerful Digital Experiences\",\n    subtext: \"UI/UX \342\200\242 Branding \342\200\242 Social Media Design \342\200\242 Website Solutions \342\200\242 Hosting & Migration \342\200\242 Frontend Development\",\n    description: \"I design and build high-performing digital experiences that help businesses stand out, engage users, and drive real results.\",\n  },\n  about: {\n    title: \"A Designer Focused on Results, Not Just Visuals\",\n    content: [\n      \"I am a Senior Visual & Web Designer with 13+ years of experience delivering high-quality digital and visual solutions across multiple industries. My expertise includes UI/UX design, branding, social media design, motion graphics, frontend technologies, and complete website solutions.\",\n      \"I have worked on multiple international projects, creating impactful websites, improving user experience, and building strong brand identities through creative and functional design.\",\n      \"I specialize in delivering end-to-end digital solutions \342\200\224 from concept and design to development, hosting, migration, and ongoing optimization.\",\n    ],\n    closing: \"Design with purpose. Build with precision. Deliver results.\",\n    stats: [\n      { label: \"Years Experience\", value: \"13+\" },\n      { label: \"Global Clients\", value: \"50+\" },\n      { label: \"Projects Delivered\", value: \"200+\" },\n    ]\n  },\n  services: [\n    {\n      title: \"UI/UX Design & Branding\",\n      description: \"Creating intuitive, visually strong interfaces and brand identities that enhance user engagement and business presence.\",\n      icon: \"Palette\"\n    },\n    {\n      title: \"Social Media & Marketing Design\",\n      description: \"Designing high-impact creatives, campaigns, banners, and promotional visuals that improve reach and engagement.\",\n      icon: \"Megaphone\"\n    },\n    {\n      title: \"Website Design & Development\",\n      description: \"Building responsive, high-performance websites with a strong focus on usability, speed, and scalability.\",\n      icon: \"Monitor\"\n    },\n    {\n      title: \"Website Management & Hosting\",\n      description: \"Hosting setup, domain management, seamless migration, performance optimization, and ongoing maintenance.\",\n      icon: \"Server\"\n    },\n    {\n      title: \"Frontend Development\",\n      description: \"Developing clean, responsive layouts using HTML, CSS, and JavaScript for fast and user-friendly experiences.\",\n      icon: \"Code\"\n    },\n    {\n      title: \"Motion Graphics & Multimedia\",\n      description: \"Creating engaging motion graphics, videos, and digital content for branding and marketing.\",\n      icon: \"Film\"\n    }\n  ],\n  process: [\n    { title: \"Understanding\", desc: \"Business goals and user needs\" },\n    { title: \"Planning\", desc: \"Structure and user flow\" },\n    { title: \"Designing\", desc: \"Clean and modern UI\" },\n    { title: \"Developing\", desc: \"Responsive and scalable solutions\" },\n    { title: \"Optimizing\", desc: \"Performance and usability\" },\n    { title: \"Delivering\", desc: \"Supporting long-term growth\" }\n  ],\n  projects: [\n    {\n      title: \"TopQore & Innovised Digital Platforms\",\n      role: \"Senior Visual & Web Designer\",\n      tags: [\"Web\", \"UI/UX\", \"Branding\", \"Video\"],\n      description: \"Designed and developed websites using modern CMS frameworks. Created branding, UI/UX, and social media creatives. Managed hosting, migrations, and maintenance. Delivered motion graphics, videos, and presentations.\"\n    },\n    {\n      title: \"Star Cover Website\",\n      role: \"UI/UX Designer & Developer\",\n      tags: [\"UI/UX\", \"Web\"],\n      description: \"Designed premium automotive UI with a luxury feel. Built responsive layouts and enhanced brand presentation.\"\n    },\n    {\n      title: \