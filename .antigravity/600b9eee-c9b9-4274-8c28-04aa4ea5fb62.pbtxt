    content: "import { ReactNode } from \"react\";\nimport { motion } from \"motion/react\";\n\ninterface AnimatedSectionProps {\n  children: ReactNode;\n  id?: string;\n  className?: string;\n}\n\nexport function AnimatedSection({ children, id, className = \"\" }: AnimatedSectionProps) {\n  return (\n    <motion.section\n      id={id}\n      initial={{ opacity: 0, y: 30 }}\n      whileInView={{ opacity: 1, y: 0 }}\n      viewport={{ once: true, margin: \"-100px\" }}\n      transition={{ duration: 0.6, ease: [0.22, 1, 0.36, 1] }}\n      className={`py-20 md:py-32 ${className}`}\n    >\n      <div className=\"mx-auto max-w-6xl px-6\">\n        {children}\n      </div>\n    </motion.section>\n  );\n}\n\nexport function SectionHeading({ title, subtitle }: { title: string, subtitle?: string }) {\n  return (\n    <div className=\"mb-16 md:mb-24\">\n      {subtitle && (\n        <span className=\"mb-4 block text-sm font-semibold uppercase tracking-widest text-emerald-600\">\n          {subtitle}\n        </span>\n      )}\n      <h2 className=\"text-3xl font-medium tracking-tight text-zinc-900 md:text-5xl lg:text-6xl max-w-3xl\">\n        {title}\n      </h2>\n    </div>\n  );\n}\n"
    raw_content: "import { ReactNode } from \"react\";\nimport { motion } from \"motion/react\";\n\ninterface AnimatedSectionProps {\n  children: ReactNode;\n  id?: string;\n  className?: string;\n}\n\nexport function AnimatedSection({ children, id, className = \"\" }: AnimatedSectionProps) {\n  return (\n    <motion.section\n      id={id}\n      initial={{ opacity: 0, y: 30 }}\n      whileInView={{ opacity: 1, y: 0 }}\n      viewport={{ once: true, margin: \"-100px\" }}\n      transition={{ duration: 0.6, ease: [0.22, 1, 0.36, 1] }}\n      className={`py-20 md:py-32 ${className}`}\n    >\n      <div className=\"mx-auto max-w-6xl px-6\">\n        {children}\n      </div>\n    </motion.section>\n  );\n}\n\nexport function SectionHeading({ title, subtitle }: { title: string, subtitle?: string }) {\n  return (\n    <div className=\"mb-16 md:mb-24\">\n      {subtitle && (\n        <span className=\"mb-4 block text-sm font-semibold uppercase tracking-widest text-emerald-600\">\n          {subtitle}\n        </span>\n      )}\n      <h2 className=\"text-3xl font-medium tracking-tight text-zinc-900 md:text-5xl lg:text-6xl max-w-3xl\">\n        {title}\n      </h2>\n    </div>\n  );\n}\n"
