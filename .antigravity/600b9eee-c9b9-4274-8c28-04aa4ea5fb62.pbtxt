      name: "create_file"
      arguments_json: "{\"Content\":\"import { useState, useEffect } from \\\"react\\\";\\nimport { siteData } from \\\"../data\\\";\\nimport { motion, AnimatePresence } from \\\"motion/react\\\";\\nimport { AnimatedSection, SectionHeading } from \\\"./AnimatedSection\\\";\\nimport { X, ZoomIn } from \\\"lucide-react\\\";\\n\\nexport function BrandingShowcase() {\\n  const [selectedLogo, setSelectedLogo] = useState<typeof siteData.branding[0] | null>(null);\\n\\n  // Prevent scrolling when modal is open\\n  useEffect(() => {\\n    if (selectedLogo) {\\n      document.body.style.overflow = \\\"hidden\\\";\\n    } else {\\n      document.body.style.overflow = \\\"\\\";\\n    }\\n    return () => {\\n      document.body.style.overflow = \\\"\\\";\\n    };\\n  }, [selectedLogo]);\\n\\n  const containerVariants = {\\n    hidden: { opacity: 0 },\\n    show: {\\n      opacity: 1,\\n      transition: {\\n        staggerChildren: 0.1\\n      }\\n    }\\n  };\\n\\n  const itemVariants = {\\n    hidden: { opacity: 0, y: 20 },\\n    show: { opacity: 1, y: 0, transition: { duration: 0.5, ease: \\\"easeOut\\\" } }\\n  };\\n\\n  return (\\n    <AnimatedSection id=\\\"branding\\\" className=\\\"bg-white dark:bg-zinc-950 transition-colors\\\">\\n      <SectionHeading subtitle=\\\"Branding & Visual Identity\\\" title=\\\"Logo Showcase\\\" />\\n      <p className=\\\"text-zinc-500 dark:text-zinc-400 mb-12 max-w-2xl text-lg mt-[-3rem]\\\">\\n        A collection of logo and brand identity work created for various industries.\\n      </p>\\n\\n      <motion.div \\n        variants={containerVariants}\\n        initial=\\\"hidden\\\"\\n        whileInView=\\\"show\\\"\\n        viewport={{ once: true, margin: \\\"-100px\\\" }}\\n        className=\\\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6\\\"\\n      >\\n        {siteData.branding.map((brand) => (\\n          <motion.div\\n            variants={itemVariants}\\n            key={brand.id}\\n            onClick={() => setSelectedLogo(brand)}\\n            className=\\\"group relative cursor-pointer overflow-hidden rounded-[2rem] bg-zinc-50 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 p-6 sm:p-8 hover:-translate-y-2 hover:shadow-xl dark:hover:shadow-emerald-500/10 hover:border-emerald-200 dark:hover:border-emerald-500/30 transition-all duration-500\\\"\\n          >\\n            {/* Soft Glow */}\\n            <div className=\\\"absolute inset-0 bg-gradient-to-tr from-emerald-500/0 via-transparent to-emerald-500/0 group-hover:from-emerald-500/5 group-hover:to-blue-500/5 dark:group-hover:from-emerald-500/10 dark:group-hover:to-blue-500/10 transition-colors duration-500\\\" />\\n            \\n            <div className=\\\"relative aspect-square flex items-center justify-center overflow-hidden mix-blend-multiply dark:mix-blend-normal\\\">\\n              {/* Note: Update \'src\' here directly when you have final client logos uploaded */}\\n              <img \\n                src={brand.img} \\n                alt={brand.name}\\n                loading=\\\"lazy\\\"\\n                referrerPolicy=\\\"no-referrer\\\"\\n                className=\\\"w-full h-full object-contain grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500 ease-out\\\"\\n              />\\n            </div>\\n\\n            {/* Overlay Info */}\\n            <div className=\\\"absolute inset-x-0 bottom-0 p-6 bg-gradient-to-t from-white via-white/80 dark:from-zinc-900 dark:via-zinc-900/80 to-transparent translate-y-8 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300\\\">\\n              <h4 className=\\\"font-semibold text-zinc-900 dark:text-zinc-50 text-sm\\\">{brand.name}</h4>\\n              <p className=\\\"text-zinc-500 dark:text-zinc-400 text-xs mt-1\\\">{brand.desc}</p>\\n            </div>\\n            \\n            <div className=\\\"absolute top-4 right-4 bg-white/90 dark:bg-zinc-800/90 backdrop-blur-sm p-2 rounded-full text-zinc-900 dark:text-zinc-50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 shadow-sm\\\">\\n              <ZoomIn size={16} />\\n            </div>\\n          </motion.div>\\n        ))}\\n      </motion.div>\\n\\n      {/* Modal Popup */}\\n      <AnimatePresence>\\n        {selectedLogo && (\\n          <motion.div\\n            initial={{ opacity: 0 }}\\n            animate={{ opacity: 1 }}\\n            exit={{ opacity: 0 }}\\n            className=\\\"fixed inset-0 z-[100] flex items-center justify-center p-4 sm:p-6\\\"\\n          >\\n            {/* Modal Backdrop */}\\n            <div \\n              className=\\\"absolute inset-0 bg-zinc-900/40 dark:bg-black/60 backdrop-blur-md\\\"\\n              onClick={() => setSelectedLogo(null)}\\n            />\\n            \\n            <motion.div\\n              initial={{ scale: 0.95, opacity: 0, y: 20 }}\\n              animate={{ scale: 1, opacity: 1, y: 0 }}\\n              exit={{ scale: 0.95, opacity: 0, y: -20 }}\\n              transition={{ type: \\\"spring\\\", damping: 25, stiffness: 300 }}\\n              className=\\\"relative w-full max-w-3xl overflow-hidden rounded-[2.5rem] bg-white dark:bg-zinc-900 shadow-2xl border border-zinc-200 dark:border-zinc-800\\\"\\n            >\\n              <button \\n                onClick={() => setSelectedLogo(null)}\\n                className=\\\"absolute top-6 right-6 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-50 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors\\\"\\n              >\\n                <X size={20} />\\n              </button>\\n              \\n              <div className=\\\"p-8 sm:p-12 lg:p-16 flex flex-col items-center text-center\\\">\\n                <div className=\\\"w-full max-w-sm aspect-square mb-10 mx-auto rounded-xl overflow-hidden bg-zinc-50 dark:bg-zinc-800/50\\\">\\n                   <img \\n                    src={selectedLogo.img} \\n                    alt={selectedLogo.name}\\n                    loading=\\\"lazy\\\"\\n                    referrerPolicy=\\\"no-referrer\\\"\\n                    className=\\\"w-full h-full object-contain mix-blend-multiply dark:mix-blend-normal\\\"\\n                  />\\n                </div>\\n                \\n                <span className=\\\"inline-flex items-center rounded-full bg-emerald-50 dark:bg-emerald-500/10 px-3 py-1 mb-4 text-xs font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400\\\">\\n                  Brand Identity\\n                </span>\\n                <h3 className=\\\"text-3xl font-medium tracking-tight text-zinc-900 dark:text-zinc-50 mb-3\\\">\\n                  {selectedLogo.name}\\n                </h3>\\n                <p className=\\\"text-zinc-500 dark:text-zinc-400 max-w-md\\\">\\n                  {selectedLogo.desc}\\n                </p>\\n              </div>\\n            </motion.div>\\n          </motion.div>\\n        )}\\n      </AnimatePresence>\\n    </AnimatedSection>\\n  );\\n}\",\"Overwrite\":true,\"TargetFile\":\"/src/components/BrandingShowcase.tsx\",\"toolAction\":\"Create Branding Showcase and Logo Grid\",\"toolSummary\":\"Create BrandingShowcase\"}"
