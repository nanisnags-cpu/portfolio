    end_line: 95
    content: "import { siteData } from \"../data\";\nimport { motion } from \"motion/react\";\nimport { ArrowRight, ChevronRight } from \"lucide-react\";\n\nexport function Hero() {\n  return (\n    <section className=\"relative flex min-h-[90vh] items-center justify-center overflow-hidden pt-20\">\n      {/* Soft animated gradient shapes */}\n      <div className=\"absolute top-1/4 -left-[10%] h-[500px] w-[500px] rounded-full bg-blue-400/20 blur-[100px] mix-blend-multiply border-none\" />\n      <div className=\"absolute bottom-1/4 -right-[10%] h-[500px] w-[500px] rounded-full bg-emerald-400/20 blur-[100px] mix-blend-multiply border-none\" />\n\n      <div className=\"mx-auto max-w-5xl px-6 text-center relative z-10\">\n        <motion.div\n          initial={{ opacity: 0, y: 30 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.8, ease: [0.16, 1, 0.3, 1] }}\n        >\n          <span className=\"mb-6 inline-flex items-center gap-2 rounded-full border border-zinc-200/60 bg-white/50 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-zinc-600 backdrop-blur-md\">\n            <span className=\"relative flex h-2 w-2\">\n              <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n              <span className=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-500\"></span>\n            </span>\n            Available for new projects\n          </span>\n          <h1 className=\"mb-8 text-5xl font-medium tracking-tight text-zinc-900 md:text-7xl lg:text-8xl leading-[1.05]\">\n            Senior Visual & <br className=\"hidden md:block\"/>\n            <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-zinc-800 to-zinc-400\">Web Designer</span>\n          </h1>\n          <p className=\"mx-auto mb-10 max-w-2xl text-lg text-zinc-500 md:text-xl leading-relaxed\">\n            {siteData.hero.description}\n          </p>\n          <div className=\"flex flex-col sm:flex-row items-center justify-center gap-4\">\n            <a\n              href=\"#projects\"\n              className=\"inline-flex h-14 items-center justify-center gap-2 rounded-full bg-zinc-900 px-8 text-sm font-medium text-white shadow-lg transition-all hover:bg-zinc-800 hover:scale-105 active:scale-95\"\n            >\n              View My Work\n              <ArrowRight size={16} />\n            </a>\n            <a\n              href=\"#contact\"\n              className=\"inline-flex h-14 items-center justify-center gap-2 rounded-full border border-zinc-200 bg-white px-8 text-sm font-medium text-zinc-900 transition-all hover:bg-zinc-50 hover:border-zinc-300\"\n            >\n              Contact Me\n            </a>\n          </div>\n        </motion.div>\n      </div>\n    </section>\n  );\n}\n\nexport function About() {\n  return (\n    <section id=\"about\" className=\"py-24 md:py-32 bg-white\">\n      <div className=\"mx-auto max-w-6xl px-6\">\n        <div className=\"grid md:grid-cols-[1fr_1.5fr] gap-16 items-start\">\n          <motion.div\n            initial={{ opacity: 0, x: -30 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true, margin: \"-100px\" }}\n            transition={{ duration: 0.6 }}\n          >\n            <h2 className=\"text-3xl font-medium tracking-tight text-zinc-900 md:text-5xl lg:leading-[1.1]\">\n              A Designer Focused on Results, <span className=\"text-zinc-400\">Not Just Visuals.</span>\n            </h2>\n            <div className=\"mt-12 space-y-6\">\n              {siteData.about.stats.map((stat, i) => (\n                <div key={i} className=\"flex items-baseline gap-4 border-b border-zinc-100 pb-6\">\n                  <div className=\"text-4xl font-medium tracking-tighter text-emerald-600\">{stat.value}</div>\n                  <div className=\"text-sm font-medium uppercase tracking-widest text-zinc-500\">{stat.label}</div>\n                </div>\n              ))}\n            </div>\n          </motion.div>\n          \n          <motion.div\n            initial={{ opacity: 0, x: 30 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true, margin: \"-100px\" }}\n            transition={{ duration: 0.6, delay: 0.2 }}\n            className=\"prose prose-zinc prose-lg\"\n          >\n            {siteData.about.content.map((p, i) => (\n              <p key={i} className=\"text-zinc-500 leading-relaxed max-w-none\">{p}</p>\n            ))}\n            <p className=\"text-xl font-medium text-zinc-900 mt-8 italic\">\n              \342\200\224 \"{siteData.about.closing}\"\n            </p>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    raw_content: "import { siteData } from \"../data\";\nimport { motion } from \"motion/react\";\nimport { ArrowRight, ChevronRight } from \"lucide-react\";\n\nexport function Hero() {\n  return (\n    <section className=\"relative flex min-h-[90vh] items-center justify-center overflow-hidden pt-20\">\n      {/* Soft animated gradient shapes */}\n      <div className=\"absolute top-1/4 -left-[10%] h-[500px] w-[500px] rounded-full bg-blue-400/20 blur-[100px] mix-blend-multiply border-none\" />\n      <div className=\"absolute bottom-1/4 -right-[10%] h-[500px] w-[500px] rounded-full bg-emerald-400/20 blur-[100px] mix-blend-multiply border-none\" />\n\n      <div className=\"mx-auto max-w-5xl px-6 text-center relative z-10\">\n        <motion.div\n          initial={{ opacity: 0, y: 30 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.8, ease: [0.16, 1, 0.3, 1] }}\n        >\n          <span className=\"mb-6 inline-flex items-center gap-2 rounded-full border border-zinc-200/60 bg-white/50 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-zinc-600 backdrop-blur-md\">\n            <span className=\"relative flex h-2 w-2\">\n              <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n              <span className=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-500\"></span>\n            </span>\n            Available for new projects\n          </span>\n          <h1 className=\"mb-8 text-5xl font-medium tracking-tight text-zinc-900 md:text-7xl lg:text-8xl leading-[1.05]\">\n            Senior Visual & <br className=\"hidden md:block\"/>\n            <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-zinc-800 to-zinc-400\">Web Designer</span>\n          </h1>\n          <p className=\"mx-auto mb-10 max-w-2xl text-lg text-zinc-500 md:text-xl leading-relaxed\">\n            {siteData.hero.description}\n          </p>\n          <div className=\"flex flex-col sm:flex-row items-center justify-center gap-4\">\n            <a\n              href=\"#projects\"\n              className=\"inline-flex h-14 items-center justify-center gap-2 rounded-full bg-zinc-900 px-8 text-sm font-medium text-white shadow-lg transition-all hover:bg-zinc-800 hover:scale-105 active:scale-95\"\n            >\n              View My Work\n              <ArrowRight size={16} />\n            </a>\n            <a\n              href=\"#contact\"\n              className=\"inline-flex h-14 items-center justify-center gap-2 rounded-full border border-zinc-200 bg-white px-8 text-sm font-medium text-zinc-900 transition-all hover:bg-zinc-50 hover:border-zinc-300\"\n            >\n              Contact Me\n            </a>\n          </div>\n        </motion.div>\n      </div>\n    </section>\n  );\n}\n\nexport function About() {\n  return (\n    <section id=\"about\" className=\"py-24 md:py-32 bg-white\">\n      <div className=\"mx-auto max-w-6xl px-6\">\n        <div className=\"grid md:grid-cols-[1fr_1.5fr] gap-16 items-start\">\n          <motion.div\n            initial={{ opacity: 0, x: -30 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true, margin: \"-100px\" }}\n            transition={{ duration: 0.6 }}\n          >\n            <h2 className=\"text-3xl font-medium tracking-tight text-zinc-900 md:text-5xl lg:leading-[1.1]\">\n              A Designer Focused on Results, <span className=\"text-zinc-400\">Not Just Visuals.</span>\n            </h2>\n            <div className=\"mt-12 space-y-6\">\n              {siteData.about.stats.map((stat, i) => (\n                <div key={i} className=\"flex items-baseline gap-4 border-b border-zinc-100 pb-6\">\n                  <div className=\"text-4xl font-medium tracking-tighter text-emerald-600\">{stat.value}</div>\n                  <div className=\"text-sm font-medium uppercase tracking-widest text-zinc-500\">{stat.label}</div>\n                </div>\n              ))}\n            </div>\n          </motion.div>\n          \n          <motion.div\n            initial={{ opacity: 0, x: 30 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true, margin: \"-100px\" }}\n            transition={{ duration: 0.6, delay: 0.2 }}\n            className=\"prose prose-zinc prose-lg\"\n          >\n            {siteData.about.content.map((p, i) => (\n              <p key={i} className=\"text-zinc-500 leading-relaxed max-w-none\">{p}</p>\n            ))}\n            <p className=\"text-xl font-medium text-zinc-900 mt-8 italic\">\n              \342\200\224 \"{siteData.about.closing}\"\n            </p>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n}\n"
