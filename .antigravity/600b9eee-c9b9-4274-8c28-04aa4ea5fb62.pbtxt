        replacement_content: "export const siteData = {\n  hero: {\n    headline: \"Senior Visual & Web Designer Creating Powerful Digital Experiences\",\n    subtext: \"UI/UX \342\200\242 Branding \342\200\242 Social Media Design \342\200\242 Website Solutions \342\200\242 Hosting & Migration \342\200\242 Frontend Development\",\n    description: \"I design and build high-performing digital experiences that help businesses stand out, engage users, and drive real results.\",\n  },\n  about: {\n    title: \"A Designer Focused on Results, Not Just Visuals\",\n    content: [\n      \"I am a Senior Visual & Web Designer with 13+ years of experience delivering high-quality digital and visual solutions across multiple industries. My expertise includes UI/UX design, branding, social media design, motion graphics, frontend technologies, and complete website solutions.\",\n      \"I have worked on multiple international projects, creating impactful websites, improving user experience, and building strong brand identities through creative and functional design.\",\n      \"I specialize in delivering end-to-end digital solutions \342\200\224 from concept and design to development, hosting, migration, and ongoing optimization.\",\n    ],\n    closing: \"Design with purpose. Build with precision. Deliver results.\",\n    stats: [\n      { label: \"Years Experience\", value: \"13+\" },\n      { label: \"Global Clients\", value: \"50+\" },\n      { label: \"Projects Delivered\", value: \"200+\" },\n    ]\n  },\n  services: [\n    {\n      title: \"UI/UX Design & Branding\",\n      description: \"Creating intuitive, visually strong interfaces and brand identities that enhance user engagement and business presence.\",\n      icon: \"Palette\"\n    },\n    {\n      title: \"Social Media & Marketing Design\",\n      description: \"Designing high-impact creatives, campaigns, banners, and promotional visuals that improve reach and engagement.\",\n      icon: \"Megaphone\"\n    },\n    {