,\\n      description: \\\"Designing high-impact creatives, campaigns, banners, and promotional visuals that improve reach and engagement.\\\",\\n      icon: \\\"Megaphone\\\"\\n    },\\n    {\\n      title: \\\"Website Design & Development\\\",\\n      description: \\\"Building responsive, high-performance websites with a strong focus on usability, speed, and scalability.\\\",\\n      icon: \\\"Monitor\\\"\\n    },\\n    {\\n      title: \\\"Website Management & Hosting\\\",\\n      description: \\\"Hosting setup, domain management, seamless migration, performance optimization, and ongoing maintenance.\\\",\\n      icon: \\\"Server\\\"\\n    },\\n    {\\n      title: \\\"Frontend Development\\\",\\n      description: \\\"Developing clean, responsive layouts using HTML, CSS, and JavaScript for fast and user-friendly experiences.\\\",\\n      icon: \\\"Code\\\"\\n    },\\n    {\\n      title: \\\"Motion Graphics & Multimedia\\\",\\n      description: \\\"Creating engaging motion graphics, videos, and digital content for branding and marketing.\\\",\\n      icon: \\\"Film\\\"\\n    }\\n  ],\\n  process: [\\n    { title: \\\"Understanding\\\", desc: \\\"Business goals and user needs\\\" },\\n    { title: \\\"Planning\\\", desc: \\\"Structure and user flow\\\" },\\n    { title: \\\"Designing\\\", desc: \\\"Clean and modern UI\\\" },\\n    { title: \\\"Developing\\\", desc: \\\"Responsive and scalable solutions\\\" },\\n    { title: \\\"Optimizing\\\", desc: \\\"Performance and usability\\\" },\\n    { title: \\\"Delivering\\\", desc: \\\"Supporting long-term growth\\\" }\\n  ],\\n  projects: [\\n    {\\n      title: \\\"TopQore & Innovised Digital Platforms\\\",\\n      role: \\\"Senior Visual & Web Designer\\\",\\n      tags: [\\\"Web\\\", \\\"UI/UX\\\", \\\"Branding\\\", \\\"Video\\\"],\\n      description: \\\"Designed and developed websites using modern CMS frameworks. Created branding, UI/UX, and social media creatives. Managed hosting, migrations, and maintenance. Delivered motion graphics, videos, and presentations.\\\"\\n    },\\n    {\\n      title: \\\"Star Cover Website\\\",\\n      role: \\\"UI/UX Designer & Developer\\\",\\n      tags: [\\\"UI/UX\\\", \\\"Web\\\"],\\n      description: \\\"Designed premium automotive UI with a luxury feel. Built responsive layouts and enhanced brand presentation.\\\"\\n    },\\n    {\\n      title: \\\"De Voorwaarts Website\\\",\\n      role: \\\"UI/UX Designer\\\",\\n      tags: [\\\"UI/UX\\\", \\\"Branding\\\"],\\n      description: \\\"Designed clean corporate UI and maintained strong branding consistency.\\\"\\n    },\\n    {\\n      title: \\\"Acqua IX Platform\\\",\\n      role: \\\"Visual Designer\\\",\\n      tags: [\\\"UI/UX\\\"],\\n      description: \\\"Designed engaging and user-friendly learning interface. Improved usability and visual appeal.\\\"\\n    },\\n    {\\n      title: \\\"Accounting Website\\\",\\n      role: \\\"Web Designer\\\",\\n      tags: [\\\"UI/UX\\\", \\\"Web\\\"],\\n      description: \\\"Created conversion-focused UI. Designed professional and structured layout.\\\"\\n    },\\n    {\\n      title: \\\"Fitness Login UI\\\",\\n      role: \\\"UI Designer\\\",\\n      tags: [\\\"UI/UX\\\"],\\n      description: \\\"Designed clean interface with strong CTA. Focused on usability and clarity.\\\"\\n    },\\n    {\\n      title: \\\"Pet Website\\\",\\n      role: \\\"UI Designer\\\",\\n      tags: [\\\"UI/UX\\\", \\\"Web\\\"],\\n      description: \\\"Created friendly and engaging layout. Improved user experience.\\\"\\n    }\\n  ],\\n  skills: {\\n    design: [\\\"Photoshop\\\", \\\"Illustrator\\\", \\\"Figma\\\", \\\"Adobe XD\\\", \\\"CorelDRAW\\\", \\\"Lightroom\\\"],\\n    web: [\\\"WordPress\\\", \\\"Elementor\\\", \\\"Divi\\\", \\\"WooCommerce\\\", \\\"Shopify\\\", \\\"UI Design\\\", \\\"Website Maintenance\\\"],\\n    frontend: [\\\"HTML\\\", \\\"CSS\\\", \\\"JavaScript (Basics)\\\"],\\n    motion: [\\\"After Effects\\\", \\\"Premiere Pro\\\", \\\"Adobe Dimension\\\", \\\"3ds Max\\\", \\\"VFX\\\", \\\"Motion Graphics\\\"],\\n    tools: [\\\"Bluehost\\\", \\\"Domain & Hosting Management\\\", \\\"Website Migration\\\", \\\"SCOM Monitoring\\\", \\\"Basic Azure\\\"]\\n  },\\n  achievements: [\\n    {\\n      title: \\\"Appreciation Award for Client Satisfaction\\\",\\n      description: \\\"Recognized for consistently delivering high-quality design solutions and maintaining strong client relationships.\\\"\\n    }\\n  ],\\n  certifications: [\\n    \\\"Diploma in Office Automation & Publishing \342\200\223 NBCE (95%)\\\",\\n    \\\"Multimedia Specialization Certification \342\200\223 Wave Infotech\\\",\\n    \\\"Diploma in Multimedia (Photoshop, Illustrator, Premiere Pro, After Effects, XD, 3D, VFX)\\\",\\n    \\\"Azure AI Fundamentals (2024)\\\",\\n    \\\"Microsoft Security, Compliance & Identity Fundamentals (2024)\\\",\\n    \\\"SCOM Operations & Administration Certification\\\"\\n  ],\\n  contact: {\\n    email: \\\"nanisnags@gmail.com\\\",\\n    phone: \\\"8143197108\\\",\\n    linkedin: \\\"https://www.linkedin.com/in/n-nagesh-347976157\\\"\\n  }\\n};\\n\",\"Overwrite\":true,\"TargetFile\":\"/src/data.ts\",\"toolAction\":\"Creating data file\",\"toolSummary\":\"Create data content file\"}"
