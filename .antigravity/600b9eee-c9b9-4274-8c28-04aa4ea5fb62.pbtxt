"flex h-12 w-12 items-center justify-center rounded-full bg-white/10 group-hover:bg-emerald-500/20 group-hover:text-emerald-400 transition-colors\">\n                  <Phone size={20} />\n                </div>\n                <span className=\"text-lg\">{siteData.contact.phone}</span>\n              </a>\n              <a href={siteData.contact.linkedin} target=\"_blank\" rel=\"noreferrer\" className=\"group flex items-center gap-4 text-zinc-300 hover:text-white transition-colors\">\n                <div className=\"flex h-12 w-12 items-center justify-center rounded-full bg-white/10 group-hover:bg-emerald-500/20 group-hover:text-emerald-400 transition-colors\">\n                  <Linkedin size={20} />\n                </div>\n                <span className=\"text-lg\">LinkedIn Profile</span>\n              </a>\n            </div>\n          </div>\n\n          <div className=\"bg-white/5 backdrop-blur-xl rounded-[2rem] border border-white/10 p-8\">\n            <form className=\"space-y-6 cursor-not-allowed\">\n              <div>\n                <label className=\"block text-sm font-medium text-zinc-400 mb-2\">Name</label>\n                <input type=\"text\" placeholder=\"John Doe\" disabled className=\"w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-emerald-500 transition-colors opacity-50 cursor-not-allowed\" />\n              </div>\n              <div>\n                <label className=\"block text-sm font-medium text-zinc-400 mb-2\">Email</label>\n                <input type=\"email\" placeholder=\"john@example.com\" disabled className=\"w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-emerald-500 transition-colors opacity-50 cursor-not-allowed\" />\n              </div>\n              <div>\n                <label className=\"block text-sm font-medium text-zinc-400 mb-2\">Message</label>\n                <textarea rows={4} placeholder=\"Tell me about your project...\" disabled className=\"w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-emerald-500 transition-colors resize-none opacity-50 cursor-not-allowed\" />\n              </div>\n              <button disabled className=\"w-full flex items-center justify-center gap-2 bg-white text-zinc-900 font-medium py-4 rounded-xl opacity-50 cursor-not-allowed\">\n                Send Message\n                <ArrowRight size={18} />\n              </button>\n            </form>\n          </div>\n        </div>\n      </div>\n    </AnimatedSection>\n  );\n}\n"
