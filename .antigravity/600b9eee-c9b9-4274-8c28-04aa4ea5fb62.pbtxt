    replacement_infos {
      original_chunk {
        target_content: "import { siteData } from \"../data\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { AnimatedSection, SectionHeading } from \"./AnimatedSection\";\nimport { Code, ExternalLink, Monitor, Palette, Play } from \"lucide-react\";\nimport { useState } from \"react\";\n\nconst filterCategories = [\"All\", \"UI/UX\", \"Web\", \"Branding\", \"Video\"];\n\nexport function Projects() {\n  const [activeFilter, setActiveFilter] = useState(\"All\");\n\n  const filteredProjects = siteData.projects.filter(p => \n    activeFilter === \"All\" ? true : p.tags.includes(activeFilter)\n  );\n\n  return (\n    <AnimatedSection id=\"projects\" className=\"bg-white\">\n      <SectionHeading subtitle=\"Featured Work\" title=\"Real Projects. Real Impact.\" />\n      \n      <div className=\"mb-12 flex flex-wrap gap-2\">\n        {filterCategories.map((filter) => (\n          <button\n            key={filter}\n            onClick={() => setActiveFilter(filter)}\n            className={`rounded-full px-5 py-2 text-sm font-medium transition-all ${\n              activeFilter === filter\n                ? \"bg-zinc-900 text-white shadow-md relative\"\n                : \"bg-zinc-100 text-zinc-600 hover:bg-zinc-200\"\n            }`}\n          >\n            {filter}\n          </button>\n        ))}\n      </div>\n\n      <div className=\"grid md:grid-cols-2 gap-8\">\n        <AnimatePresence mode=\"popLayout\">\n          {filteredProjects.map((project, i) => (\n            <motion.div\n              layout\n              initial={{ opacity: 0, scale: 0.95 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 0.95 }}\n              transition={{ duration: 0.4 }}\n              key={project.title}\n              className=\"group relative cursor-pointer overflow-hidden rounded-[2rem] bg-zinc-50 border border-zinc-100 p-8 sm:p-10 hover:border-zinc-200 transition-colors\"\n            >\n              /* Dummy decorative image background depending on index for visual variety */\n              <div className=\"absolute inset-0 bg-gradient-to-br from-white/50 to-transparent mix-blend-overlay pointer-events-none\" />\n              \n              <div className=\"relative z-10 flex h-full flex-col justify-between\">\n                <div>\n                  <div className=\"flex flex-wrap gap-2 mb-6\">\n                    {project.tags.map(tag => (\n                      <span key={tag} className=\"rounded-full bg-white px-3 py-1 text-xs font-semibold uppercase tracking-wider text-zinc-500 shadow-sm\">\n                        {tag}\n                      </span>\n                    ))}\n                  </div>\n                  <h3 className=\"text-2xl sm:text-3xl font-medium tracking-tight text-zinc-900 mb-2\">{project.title}</h3>\n                  <div className=\"text-emerald-600 font-medium text-sm uppercase tracking-wider mb-6 block\">{project.role}</div>\n                  <p className=\"text-zinc-500 leading-relaxed mb-10 max-w-md\">{project.description}</p>\n                </div>\n                \n                <div className=\"flex items-center gap-4 mt-auto\">\n                  <div className=\"flex h-12 w-12 items-center justify-center rounded-full bg-white shadow-sm transition-transform group-hover:scale-110 group-hover:shadow-md text-zinc-900\">\n                    <ExternalLink size={20} />\n                  </div>\n                  <span className=\"text-sm font-medium text-zinc-900 opacity-0 transform translate-x-2 transition-all group-hover:opacity-100 group-hover:translate-x-0\">View Details</span>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </AnimatePresence>\n      </div>\n    </AnimatedSection>\n  );\n}"
        replacement_content: "import { siteData } from \"../data\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { AnimatedSection, SectionHeading } from \"./AnimatedSection\";\nimport { Code, ExternalLink, Monitor, Palette, Play } from \"lucide-react\";\nimport { useState } from \"react\";\n\nconst filterCategories = [\"All\", \"UI/UX\", \"Web\", \"Branding\", \"Video\"];\n\nexport function Projects() {\n  const [activeFilter, setActiveFilter] = useState(\"All\");\n\n  const filteredProjects = siteData.projects.filter(p => \n    activeFilter === \"All\" ? true : p.tags.includes(activeFilter)\n  );\n\n  return (\n    <AnimatedSection id=\"projects\" className=\"bg-white dark:bg-zinc-950 transition-colors\">\n      <SectionHeading subtitle=\"Featured Work\" title=\"Real Projects. Real Impact.\" />\n      \n      <div className=\"mb-12 flex flex-wrap gap-2\">\n        {filterCategories.map((filter) => (\n          <button\n            key={filter}\n            onClick={() => setActiveFilter(filter)}\n            className={`rounded-full px-5 py-2 text-sm font-medium transition-all ${\n              activeFilter === filter\n                ? \"bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 shadow-md relative\"\n                : \"bg-zinc-100 dark:bg-zinc-900/50 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-200 dark:hover:bg-zinc-800\"\n            }`}\n          >\n            {filter}\n          </button>\n        ))}\n      </div>\n\n      <div className=\"grid md:grid-cols-2 gap-8\">\n        <AnimatePresence mode=\"popLayout\">\n          {filteredProjects.map((project, i) => (\n            <motion.div\n              layout\n              initial={{ opacity: 0, scale: 0.95 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 0.95 }}\n              transition={{ duration: 0.4 }}\n              key={project.title}\n              className=\"group relative cursor-pointer overflow-hidden rounded-[2rem] bg-zinc-50 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 p-8 sm:p-10 hover:border-zinc-200 dark:hover:border-zinc-700 transition-colors\"\n            >\n              {/* Dummy decorative image background depending on index for visual variety */}\n              <div className=\"absolute inset-0 bg-gradient-to-br from-white/50 dark:from-zinc-800/30 to-transparent mix-blend-overlay pointer-events-none\" />\n              \n              <div className=\"relative z-10 flex h-full flex-col justify-between\">\n                <div>\n                  <div className=\"flex flex-wrap gap-2 mb-6\">\n                    {project.tags.map(tag => (\n                      <span key={tag} className=\"rounded-full bg-white dark:bg-zinc-800 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-300 shadow-sm border border-transparent dark:border-white/5\">\n                        {tag}\n                      </span>\n                    ))}\n                  </div>\n                  <h3 className=\"text-2xl sm:text-3xl font-medium tracking-tight text-zinc-900 dark:text-zinc-50 mb-2\">{project.title}</h3>\n                  <div className=\"text-emerald-600 dark:text-emerald-400 font-medium text-sm uppercase tracking-wider mb-6 block\">{project.role}</div>\n                  <p className=\"text-zinc-500 dark:text-zinc-400 leading-relaxed mb-10 max-w-md\">{project.description}</p>\n                </div>\n                \n                <div className=\"flex items-center gap-4 mt-auto\">\n                  <div className=\"flex h-12 w-12 items-center justify-center rounded-full bg-white dark:bg-zinc-950 shadow-sm transition-transform group-hover:scale-110 group-hover:shadow-md text-zinc-900 dark:text-zinc-50\">\n                    <ExternalLink size={20} />\n                  </div>\n                  <span className=\"text-sm font-medium text-zinc-900 dark:text-zinc-50 opacity-0 transform translate-x-2 transition-all group-hover:opacity-100 group-hover:translate-x-0\">View Details</span>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </AnimatePresence>\n      </div>\n    </AnimatedSection>\n  );\n}"
      }
      fuzzy_match: "import { siteData } from \"../data\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { AnimatedSection, SectionHeading } from \"./AnimatedSection\";\nimport { Code, ExternalLink, Monitor, Palette, Play } from \"lucide-react\";\nimport { useState } from \"react\";\n\nconst filterCategories = [\"All\", \"UI/UX\", \"Web\", \"Branding\", \"Video\"];\n\nexport function Projects() {\n  const [activeFilter, setActiveFilter] = useState(\"All\");\n\n  const filteredProjects = siteData.projects.filter(p => \n    activeFilter === \"All\" ? true : p.tags.includes(activeFilter)\n  );\n\n  return (\n    <AnimatedSection id=\"projects\" className=\"bg-white\">\n      <SectionHeading subtitle=\"Featured Work\" title=\"Real Projects. Real Impact.\" />\n      \n      <div className=\"mb-12 flex flex-wrap gap-2\">\n        {filterCategories.map((filter) => (\n          <button\n            key={filter}\n            onClick={() => setActiveFilter(filter)}\n            className={`rounded-full px-5 py-2 text-sm font-medium transition-all ${\n              activeFilter === filter\n                ? \"bg-zinc-900 text-white shadow-md relative\"\n                : \"bg-zinc-100 text-zinc-600 hover:bg-zinc-200\"\n            }`}\n          >\n            {filter}\n          </button>\n        ))}\n      </div>\n\n      <div className=\"grid md:grid-cols-2 gap-8\">\n        <AnimatePresence mode=\"popLayout\">\n          {filteredProjects.map((project, i) => (\n            <motion.div\n              layout\n              initial={{ opacity: 0, scale: 0.95 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 0.95 }}\n              transition={{ duration: 0.4 }}\n              key={project.title}\n              className=\"group relative cursor-pointer overflow-hidden rounded-[2rem] bg-zinc-50 border border-zinc-100 p-8 sm:p-10 hover:border-zinc-200 transition-colors\"\n            >\n              {/* Dummy deco