    replacement_chunks {
      target_content: "  projects: [\n    {\n      title: \"TopQore & Innovised Digital Platforms\",\n      role: \"Senior Visual & Web Designer\",\n      tags: [\"Web\", \"UI/UX\", \"Branding\", \"Video\"],\n      description: \"Designed and developed websites using modern CMS frameworks. Created branding, UI/UX, and social media creatives. Managed hosting, migrations, and maintenance. Delivered motion graphics, videos, and presentations.\"\n    },\n    {\n      title: \"Star Cover Website\",\n      role: \"UI/UX Designer & Developer\",\n      tags: [\"UI/UX\", \"Web\"],\n      description: \"Designed premium automotive UI with a luxury feel. Built responsive layouts and enhanced brand presentation.\"\n    },\n    {\n      title: \"De Voorwaarts Website\",\n      role: \"UI/UX Designer\",\n      tags: [\"UI/UX\", \"Branding\"],\n      description: \"Designed clean corporate UI and maintained strong branding consistency.\"\n    },\n    {\n      title: \"Acqua IX Platform\",\n      role: \"Visual Designer\",\n      tags: [\"UI/UX\"],\n      description: \"Designed engaging and user-friendly learning interface. Improved usability and visual appeal.\"\n    },\n    {\n      title: \"Accounting Website\",\n      role: \"Web Designer\",\n      tags: [\"UI/UX\", \"Web\"],\n      description: \"Created conversion-focused UI. Designed professional and structured layout.\"\n    },\n    {\n      title: \"Fitness Login UI\",\n      role: \"UI Designer\",\n      tags: [\"UI/UX\"],\n      description: \"Designed clean interface with strong CTA. Focused on usability and clarity.\"\n    },\n    {\n      title: \"Pet Website\",\n      role: \"UI Designer\",\n      tags: [\"UI/UX\", \"Web\"],\n      description: \"Created friendly and engaging layout. Improved user experience.\"\n    }\n  ],"
      replacement_content: "  projects: [\n    {\n      title: \"TopQore & Innovised Digital Platforms\",\n      role: \"Senior Visual & Web Designer\",\n      tags: [\"Web\", \"UI/UX\", \"Branding\", \"Video\"],\n      description: \"Designed responsive websites using WordPress & premium page builders. Created high-converting UI landing pages, sleek iconography, and custom media components. Configured domain hosting, database structures, and high-performance routing layouts.\",\n      image: \"https://images.unsplash.com/photo-1531403009284-440f080d1e12?auto=format&fit=crop&w=1000&q=80\",\n      platform: \"WordPress + Elementor Pro\",\n      link: \"https://topqore.com\"\n    },\n    {\n      title: \"Star Cover Website\",\n      role: \"UI/UX Designer & Developer\",\n      tags: [\"UI/UX\", \"Web\"],\n      description: \"Crafted a luxury corporate web experience on WordPress utilizing a customized premium framework. Engineered slick car layouts, tailored product display modules, and optimized CSS animation trees.\",\n      image: \"https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?auto=format&fit=crop&w=1000&q=80\",\n      platform: \"WordPress Custom Theme\",\n      link: \"https://starcover.nl\"\n    },\n    {\n      title: \"De Voorwaarts Website\",\n      role: \"UI/UX Designer\",\n      tags: [\"UI/UX\", \"Branding\"],\n      description: \"Formulated a streamlined, modern brand appearance and digital interface. Built pixel-perfect responsive page layouts focusing heavily on typography structure and aesthetic branding cohesion.\",\n      image: \"https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1000&q=80\",\n      platform: \"WordPress + Custom Builder\",\n      link: \"#\"\n    },\n    {\n      title: \"Acqua IX Platform\",\n      role: \"Visual Designer\",\n      tags: [\"UI/UX\"],\n      description: \"Redefined user experience for digital workspace learning environments. Restructured logical dashboard architecture, and built tailored dashboard views increasing user course completion rates.\",\n      image: \"https://images.unsplash.com/photo-1501504905252-473c47e087f8?auto=format&fit=crop&w=1000&q=80\",\n      platform: \"UI/UX Design Mock\",\n      link: \"#\"\n    },\n    {\n      title: \"Accounting Website\",\n      role: \"Web Designer\",\n      tags: [\"UI/UX\", \"Web\"],\n      description: \"Engineered a conversion-focused accounting & advisory WordPress website. Outfitted customized contact flows, clean responsive pricing matrices, and fully optimized site speed metrics.\",\n      image: \"https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1000&q=80\",\n      platform: \"WordPress + Elementor\",\n      link: \"#\"\n    },\n    {\n      title: \"Fitness Login UI\",\n      role: \"UI Designer\",\n      tags: [\"UI/UX\"],\n      description: \"A dark sleek app login structure designed for fitness tracking enthusiasts. Curated focused input fields, striking high-impact background images, and a robust Call-to-Action pattern.\",\n      image: \"https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&w=1000&q=80\",\n      platform: \"Figma App UI\",\n      link: \"#\"\n    },\n    {\n      title: \"Pet Website\",\n      role: \"UI Designer\",\n      tags: [\"UI/UX\", \"Web\"],\n      description: \"Designed a friendly, vibrant WordPress theme built using Divi. Configured warm pastel color ranges, intuitive animal boarding grids, and simple contact matrices.\",\n      image: \"https://images.unsplash.com/photo-1544568100-847a948585b9?auto=format&fit=crop&w=1000&q=80\",\n      platform: \"WordPress + Divi Builder\",\n      link: \"#\"\n    }\n  ],"
    }
